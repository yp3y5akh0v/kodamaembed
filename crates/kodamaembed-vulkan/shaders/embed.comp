#version 460
// LayerNorm((word + token_type) + position): the CPU's summation order.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x_id = 0) in;

const uint QUARTER = gl_WorkGroupSize.x, WIDTH = 4 * QUARTER;

layout(std430, binding = 0) readonly buffer Ids { int ids[]; };
layout(std430, binding = 1) readonly buffer Types { int types[]; };
layout(std430, binding = 2) readonly buffer Positions { int positions[]; };
layout(std430, binding = 3) readonly buffer Word { vec4 word[]; };
layout(std430, binding = 4) readonly buffer Position { vec4 position[]; };
layout(std430, binding = 5) readonly buffer TokenType { vec4 token_type[]; };
layout(std430, binding = 6) readonly buffer Gamma { vec4 gamma[]; };
layout(std430, binding = 7) readonly buffer Beta { vec4 beta[]; };
layout(std430, binding = 8) writeonly buffer Out16 { f16vec4 out16[]; };
layout(std430, binding = 9) writeonly buffer Out32 { vec4 out32[]; };

layout(push_constant) uniform Push {
    uint tokens;
    float eps;
} p;

shared float partial[64];

float block_sum(float value) {
    value = subgroupAdd(value);
    if (subgroupElect()) partial[gl_SubgroupID] = value;
    barrier();
    float total = 0.0;
    for (uint i = 0; i < gl_NumSubgroups; ++i) total += partial[i];
    barrier();
    return total;
}

void main() {
    const uint token = gl_WorkGroupID.x;
    const uint column = gl_LocalInvocationID.x;
    const vec4 v = (word[uint(ids[token]) * QUARTER + column] +
                    token_type[uint(types[token]) * QUARTER + column]) +
                   position[uint(positions[token]) * QUARTER + column];
    const float mean = block_sum((v.x + v.y) + (v.z + v.w)) / float(WIDTH);
    const vec4 d = v - mean;
    const float variance = block_sum(dot(d, d)) / float(WIDTH);
    const float denominator = variance + p.eps;
    // A non-finite variance must not be masked by inversesqrt(+inf) == zero.
    const vec4 y = (isnan(denominator) || isinf(denominator))
        ? vec4(uintBitsToFloat(0x7fc00000u))
        : d * inversesqrt(denominator) * gamma[column] + beta[column];
    const uint at = token * QUARTER + column;
    out16[at] = f16vec4(y);
    out32[at] = y;
}
